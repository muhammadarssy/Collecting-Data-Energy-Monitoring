# PostgreSQL connection string
DB_URL=postgresql://user:pass@localhost:5432/energy_db

# Ring buffer per meter (jumlah sample). 240 = 2 menit @ 500ms
BUFFER_MAXLEN=240

# Durasi HIGH maksimal (detik) sebelum sesi dianggap selesai
CYCLE_TIMEOUT_SECONDS=300

# Interval polling per meter (milidetik) — live buffer/Redis untuk energy & utils
POLL_INTERVAL_MS=500

# Interval persist history ke PostgreSQL untuk energy & utils (detik). Default 300 = 5 menit.
# Reading history memakai session_id lifetime aplikasi (tanpa cycle_id).
# GPIO energy tetap untuk tabel production_cycles saja.
UTILS_HISTORY_INTERVAL_SECONDS=300

# Path config
METERS_CONFIG_PATH=config/meters.yaml
REGISTER_MAP_PATH=config/registers.yaml

# Logging
LOG_LEVEL=INFO

# GPIO memakai `import RPi.GPIO as GPIO` — di Pi pasang rpi-lgpio (bukan RPi.GPIO klasik):
#   sudo apt remove python3-rpi.gpio && sudo apt install python3-rpi-lgpio
#
# Paksa mock Modbus untuk dev di Windows.
USE_MOCK_HARDWARE=true

# Redis — mirror buffer & device info (opsional)
# REDIS_URL=redis://localhost:6379/0
# COLLECTOR_ID=pi-line-1
# DEVICE_INFO_TTL_SECONDS=86400
# REDIS_KEY_PREFIX=energy
