[Unit]
Description=Energy Meter Data Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Nilai User/Group/path diisi ulang oleh deploy/install-service.sh
User=collector
Group=collector
# Jangan hardcode gpio: grup itu tidak ada di mini PC Linux dan service gagal start.
# install-service.sh menambahkan SupplementaryGroups=gpio dan/atau dialout jika ada.

WorkingDirectory=/opt/energy-collector
EnvironmentFile=-/opt/energy-collector/.env
ExecStart=/opt/energy-collector/.venv/bin/python /opt/energy-collector/main.py

# Restart otomatis kalau crash; SIGTERM dari systemd ditangani di main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Log ke journald: journalctl -u energy-collector -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=energy-collector

[Install]
WantedBy=multi-user.target
